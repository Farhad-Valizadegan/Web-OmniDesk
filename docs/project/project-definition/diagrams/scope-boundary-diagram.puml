@startuml
title OmniDesk AI Scope Boundary

left to right direction
skinparam componentStyle rectangle

rectangle "Inside Current MVP Scope" as In {
  rectangle "Authentication and authorization" as A
  rectangle "Gmail and Telegram connections" as B
  rectangle "Unified communication workspace" as C
  rectangle "Synchronization and normalization" as D
  rectangle "Search and local organization" as E
  rectangle "User-requested AI assistance" as F
}

rectangle "Outside Current MVP Scope" as Out {
  rectangle "WhatsApp, Instagram, Slack" as G
  rectangle "Autonomous message sending" as H
  rectangle "Unapproved future-provider features" as I
  rectangle "Provider policy and availability" as J
  rectangle "AI model ownership or training" as K
}
@enduml