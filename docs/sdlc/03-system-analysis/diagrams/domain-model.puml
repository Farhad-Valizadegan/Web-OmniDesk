@startuml
title OmniDesk AI Domain Model

skinparam classAttributeIconSize 0
hide methods

class User {
  userId
  email
}

class ProviderAccount {
  connectionId
  providerType
  connectionStatus
}

class Provider {
  providerId
  name
}

class Conversation {
  conversationId
  subject
  lastActivityAt
}

class Message {
  messageId
  providerMessageId
  sentAt
  content
}

class Label {
  labelId
  name
}

class Synchronization {
  syncId
  status
  startedAt
  completedAt
}

class AISuggestion {
  suggestionId
  type
  status
  content
}

User "1" -- "0..*" ProviderAccount : owns
ProviderAccount "*" -- "1" Provider : uses
ProviderAccount "1" -- "0..*" Conversation : contains
Conversation "1" *-- "1..*" Message : consists of
User "1" -- "0..*" Label : defines
Conversation "0..*" -- "0..*" Label : organized by
ProviderAccount "1" -- "0..*" Synchronization : has
User "1" -- "0..*" AISuggestion : reviews
Conversation "1" -- "0..*" AISuggestion : informs
@enduml