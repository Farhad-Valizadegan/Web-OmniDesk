@startuml
title OmniDesk Module Boundary Diagram

left to right direction
skinparam componentStyle rectangle

package "Identity Module" as Identity {
  component "Authentication"
  component "Authorization"
  component "User Management"
}

package "Communication Module" as Communication {
  component "Unified Workspace"
  component "Conversation Management"
  component "Search and Organization"
}

package "Synchronization Module" as Synchronization {
  component "Sync Coordinator"
  component "Data Validator"
  component "Normalization Service"
  component "Duplicate Prevention"
}

package "Provider Integration Module" as Providers {
  component "Provider Connector Interface"
  component "Gmail Connector"
  component "Telegram Connector"
}

package "Shared Domain" as Domain {
  component "User"
  component "Provider Account"
  component "Conversation"
  component "Message"
  component "Label"
  component "Synchronization Record"
}

database "Persistence Boundary" as Persistence

Identity --> Domain
Communication --> Domain
Synchronization --> Domain
Providers --> Domain

Communication --> Identity : protected access
Synchronization --> Providers : retrieve provider data
Synchronization --> Communication : publish normalized data

Identity --> Persistence
Communication --> Persistence
Synchronization --> Persistence

@enduml
