@startuml
title OmniDesk AI System Architecture

left to right direction
skinparam componentStyle rectangle

actor "Primary User" as User

package "Client Layer" {
  component "React + TypeScript Web Client" as Client
}

package "Application Layer" {
  component "Laravel REST API" as API
  component "Authentication and Authorization" as Auth
  component "Unified Workspace Module" as Workspace
  component "Synchronization Module" as Sync
  component "AI Assistance Module" as AIAssist
  component "Provider Connector Boundary" as Connectors
}

package "Data Layer" {
  database "PostgreSQL" as DB
  database "Redis" as Redis
}

package "External Services" {
  component "Gmail API" as Gmail
  component "Telegram API" as Telegram
  component "Selected AI Service" as AIService
}

User --> Client : uses workspace
Client --> API : REST / JSON

API --> Auth
API --> Workspace
API --> Sync
API --> AIAssist

Auth --> DB
Workspace --> DB
Workspace --> Redis
Sync --> Connectors
Sync --> DB
Sync --> Redis
AIAssist --> DB
AIAssist --> Connectors

Connectors --> Gmail : retrieve communication data
Connectors --> Telegram : retrieve communication data
AIAssist --> AIService : approved AI request
AIService --> AIAssist : summary or editable suggestion

@enduml